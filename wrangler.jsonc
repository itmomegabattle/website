{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "website",
  "compatibility_date": "2026-08-29",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "megabattle.site",
      "custom_domain": true
    },
    {
      "pattern": "www.megabattle.site",
      "custom_domain": true
    }
  ]
}
